# frontend/.env.example
# 이 파일을 .env.local로 복사해서 쓴다. .env.local은 gitignore 대상 — 절대 커밋 금지.
#
# 이 앱이 읽는 환경변수 목록이다. docker compose로 띄울 때는 이 파일이 아니라
# infra/.env가 쓰이므로 그쪽 값을 채운다(기동 절차: 루트 INSTALL.md).
#
# 작성 규칙:
#   - "필수(비밀)" 표시된 항목은 반드시 채운다. 절대 이 예시 파일에 값을 넣지 않는다.
#   - `=` 앞뒤에 공백을 넣지 않고, 값에 따옴표를 붙이지 않으며, 값 뒤에 주석을 달지 않는다.

# --- BFF 단일 진입점 (브라우저는 오직 BFF만 호출) ---
# 브라우저가 호출할 BFF 주소.
NEXT_PUBLIC_BFF_BASE_URL=http://localhost:8090

# --- Keycloak ---
# `next dev`는 3000번으로 뜬다. Keycloak client의 redirect URI·web origin도 3000으로 맞춘다.
NEXTAUTH_URL=http://localhost:3000
# 필수(비밀) — openssl rand -base64 32 등으로 생성
NEXTAUTH_SECRET=
KEYCLOAK_ISSUER=http://localhost:8081/realms/app-realm
KEYCLOAK_CLIENT_ID=ogjg-client
# 필수(비밀) — Keycloak 콘솔 ogjg-client → Credentials 탭에서 확인
KEYCLOAK_CLIENT_SECRET=

# --- 목업 WS 서버 (선택) ---
# 협업채팅 WS를 실서버 대신 목업(`bun run mock:ws`)으로 받고 싶을 때만 채운다.
# 비워 두면 WS도 위 BFF 주소로 붙는다. HTTP 목업 라우트와는 무관하게 WS만 갈아끼운다.
NEXT_PUBLIC_MOCK_WS_URL=
