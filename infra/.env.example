# docker-compose 용 환경변수 템플릿.
#
# 이 파일은 **복사해서 바로 쓰는 값**으로 채워져 있다:
#     Copy-Item .env.example .env
# 고칠 곳은 **모델 연결 한 줄뿐이다**(아래 LiteLLM 절의 GEMINI_API_KEY — 무료로 발급된다).
# 나머지 계정·비밀번호·주소는 그대로 두면 된다.
#
# 🔒 아래 비밀번호·토큰은 저장소에 공개된 값이라 **아무나 알 수 있다.**
#    집·사무실 안에서 혼자 시험하는 용도로만 쓰고, 여러 사람이 접속하게 하거나
#    믿을 수 없는 네트워크에 두려면 반드시 바꾼다 — 단, 최초 기동 전에 바꿔야 한다.
#
# 작성 규칙:
#   - `=` 앞뒤에 공백을 넣지 않는다.
#   - 값에 따옴표를 붙이지 않는다.
#   - 값 뒤에 주석을 달지 않는다 (`#` 뒤까지 값에 포함될 수 있다).

# --- PostgreSQL ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=9hSoDrL8HxfBCUr1iNO96T6igjAxfK2U2Q2U7Kwd
POSTGRES_DB=appdb

# --- Keycloak ---
# 관리자 화면(http://localhost:8081/admin) 로그인 — 계정 추가·설정 확인용. 설치에는 필요 없다.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=app-realm
KEYCLOAK_CLIENT_ID=ogjg-client
# 화면과 로그인 서버가 주고받는 열쇠. config/realm-app.json이 이 값으로 client를 만든다.
KEYCLOAK_CLIENT_SECRET=3v4yUxdNgF8gdsbnNFtlKeMstKfzcf6g6odhRLEj

# 최초 기동 때 자동으로 만들어지는 로그인 계정(realm import). **채팅에 로그인할 때 쓸 계정이다.**
APP_USER=appuser
APP_USER_PASSWORD=appuser
# 리버스 프록시(caddy) 뒤에서 X-Forwarded-* 헤더를 신뢰하도록 한다.
KEYCLOAK_PROXY_HEADERS=xforwarded

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-wGj3LppVio9YfzC80ruK8ggMVCpnn47CjDB8Sz7a
LITELLM_SALT_KEY=eQ8GnrEw5PmaCcF17mYV2nMQxM1fvGyOPbwD17aq
# BFF의 폴백 모델 — 요청에 모델이 실려 있지 않을 때만 쓰인다.
# 화면에서 보내는 요청은 항상 드롭다운에서 고른 모델을 싣기 때문에 평소엔 쓰이지 않는다.
# 화면의 기본 선택은 config/litellm_config.yaml의 model_list **맨 위 항목**이다.
LLM_MODEL=gemini-3.6-flash
#
# 공급자별 API 키 — **쓰는 곳의 키만 채우면 된다.**
# 셋 다 화면의 모델 목록에 뜬다. 키를 안 채운 모델을 고르면 대화가 거절되고 화면이 그 사실을
# 안내한다 — 목록에서 아예 빼려면 config/litellm_config.yaml에서 그 항목을 주석 처리한다.
# 엔드포인트 주소는 키가 아니라서 그쪽 파일에 적어두었다.
#
#   Gemini    무료 등급이 있어 결제 없이 바로 써볼 수 있다(기본 선택 모델).
#             키 발급 https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Claude    키 발급 https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
#   OpenAI    무료 등급이 없다 — 크레딧을 선결제해야 키가 동작한다.
#             키 발급 https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# 내 PC에서 직접 돌리는 모델(Ollama)의 주소. 키는 필요 없다.
# 설치 절차는 INSTALL.md 2단계 B.
OLLAMA_API_BASE=http://host.docker.internal:11434/v1
#
# 모델 구성을 통째로 달리 쓰는 환경(사내 온프렘 등)만 쓴다. 기본값은 저장소의
# config/litellm_config.yaml 이고, 그 파일을 직접 고치면 git pull이 충돌하므로
# 자기 파일을 따로 두고 여기서 가리킨다. 저장소 밖의 절대경로도 된다.
#LITELLM_CONFIG_FILE=/home/ogjg/litellm_config.server.yaml

# --- Caddy (HTTPS·도메인) ---
#
# .env에 COMPOSE_PROFILES=caddy 를 넣어 caddy를 켤 때만 쓰인다. 그대로 두면
# app.localhost / api.localhost / auth.localhost 로 뜬다.
#
# 자기 도메인을 쓰려면 세 줄의 주석을 풀고 바꾼다. **Caddyfile은 고치지 않는다** —
# 추적 파일을 고치면 다음 git pull이 충돌한다. 아래 PUBLIC_* 세 줄과 NEXTAUTH_URL도
# 같은 주소로 맞춰야 한다. 자세한 절차는 INSTALL_r-proxy.md의 "주소 이름 바꾸기".
#CADDY_APP_DOMAIN=app.example.com
#CADDY_API_DOMAIN=api.example.com
#CADDY_AUTH_DOMAIN=auth.example.com

# --- BFF (Spring Boot) ---
SPRING_PROFILE=prod
BFF_IMAGE=ogjg-bff:local

# --- Frontend (Next.js) ---
FRONTEND_IMAGE=ogjg-nextjs:local
NEXTAUTH_SECRET=JLv9GSicYiXjqSQ2fErPPRbv4kZ7Fff42eEQsXOe

# --- 공개 접근 URL (브라우저가 접근하는 주소) ---
#
# 도커를 돌리는 그 PC에서 접속하는 전제의 값이다. 그대로 두면 된다.
#
# 네 줄 모두 **브라우저가 보는 주소**다. 서버끼리 주고받는 구간은 도커 내부 주소를
# 따로 쓰므로(compose의 KEYCLOAK_INTERNAL_ISSUER) 여기에 localhost를 둬도 안전하다.
#
# 같은 네트워크의 다른 기기(폰 등)에서도 접속하려면 네 줄을 모두 이 PC의 IP로 바꾼다.
#   확인: ipconfig | Select-String "IPv4"   →  예) http://192.168.0.15:3010
NEXTAUTH_URL=http://localhost:3010
PUBLIC_FRONTEND_URL=http://localhost:3010
PUBLIC_BFF_URL=http://localhost:8090
PUBLIC_KEYCLOAK_URL=http://localhost:8081
